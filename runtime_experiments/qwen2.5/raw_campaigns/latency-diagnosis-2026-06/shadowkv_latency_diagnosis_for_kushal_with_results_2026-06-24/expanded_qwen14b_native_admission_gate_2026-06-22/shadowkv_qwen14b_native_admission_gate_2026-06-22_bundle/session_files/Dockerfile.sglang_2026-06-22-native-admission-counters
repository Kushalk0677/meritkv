import json
import os
import time
from pathlib import Path

try:
    import fcntl
except Exception:  # pragma: no cover
    fcntl = None


def _path() -> Path:
    return Path(os.environ.get("SHADOWKV_ADMISSION_METRICS_PATH", "/tmp/shadowkv_admission_metrics.json"))


def _locked_update(mutator):
    path = _path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+", encoding="utf-8") as handle:
        if fcntl is not None:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        handle.seek(0)
        raw = handle.read().strip()
        try:
            payload = json.loads(raw) if raw else {}
        except Exception:
            payload = {}
        counters = dict(payload.get("counters") or {})
        result = mutator(counters)
        payload = {
            "path": str(path),
            "updated_at": time.time(),
            "counters": counters,
        }
        handle.seek(0)
        handle.truncate()
        handle.write(json.dumps(payload, sort_keys=True))
        handle.flush()
        os.fsync(handle.fileno())
        if fcntl is not None:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        return result if result is not None else payload


def inc(name: str, amount: int | float = 1):
    def mutate(counters):
        counters[name] = counters.get(name, 0) + amount
    return _locked_update(mutate)


def snapshot():
    path = _path()
    if not path.exists():
        return {"path": str(path), "updated_at": None, "counters": {}}
    with path.open("r", encoding="utf-8") as handle:
        if fcntl is not None:
            fcntl.flock(handle.fileno(), fcntl.LOCK_SH)
        raw = handle.read().strip()
        if fcntl is not None:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    try:
        payload = json.loads(raw) if raw else {}
    except Exception:
        payload = {}
    payload.setdefault("path", str(path))
    payload.setdefault("updated_at", None)
    payload.setdefault("counters", {})
    return payload


def reset():
    def mutate(counters):
        counters.clear()
    return _locked_update(mutate)
'''.lstrip()
